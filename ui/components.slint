import { Backdrop, Theme } from "theme.slint";

// Material Icons glyph
export component Icon inherits Text {
    font-family: "Material Icons";
    font-size: 20px;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// ---------------------------------------------------------------------------
// Ultra-fast Liquid Glass surface (single blurred texture, zero offscreen FBOs)
// ---------------------------------------------------------------------------
export component Glass inherits Rectangle {
    in property <color> tint: Theme.glass-regular;
    in property <length> radius: 26px;
    in property <bool> show-rim: true;

    border-radius: radius;
    clip: true;

    Image {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: Backdrop.win-width;
        height: Backdrop.win-height;
        source: Backdrop.blurred;
        image-fit: cover;
    }

    Rectangle {
        border-radius: root.radius;
        background: root.tint;
        animate background {
            duration: 220ms;
            easing: ease-out;
        }
    }

    if root.show-rim: Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: Theme.glass-rim-color;
        background: transparent;
        animate border-color { duration: 220ms; }
    }

    @children
}

// ---------------------------------------------------------------------------
// Clean high-FPS capsule button
// ---------------------------------------------------------------------------
export component GlassButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <string> kind: "secondary"; // "primary" | "danger" | "secondary"
    in property <bool> enabled: true;
    in property <length> btn-height: 40px;
    callback clicked;

    height: btn-height;
    min-width: root.text == "" ? root.btn-height : 0px;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.45;
    background: kind == "primary"
        ? (ta.pressed ? #D94F0CEB : (ta.has-hover ? #FF7D38EB : #FF6A1FE0))
        : kind == "danger"
        ? (ta.pressed ? #CC251CEB : (ta.has-hover ? #FF544AEB : #FF3B30E0))
        : (ta.pressed ? Theme.droplet-bg : (ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile));

    animate background { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        spacing: (root.icon != "" && root.text != "") ? 7px : 0px;
        padding-left: root.text == "" ? 0px : (root.btn-height >= 48px ? 22px : 15px);
        padding-right: root.text == "" ? 0px : (root.btn-height >= 48px ? 22px : 15px);
        padding-top: ta.pressed ? 1.5px : 0px;

        if root.icon != "": Icon {
            text: root.icon;
            font-size: root.btn-height >= 48px ? 21px : 17px;
            color: root.kind == "secondary" ? Theme.text-primary : Theme.text-on-accent;
            animate color { duration: 150ms; }
        }

        if root.text != "": Text {
            text: root.text;
            font-size: root.btn-height >= 48px ? 15.5px : 13px;
            font-weight: root.kind == "secondary" ? 600 : 700;
            color: root.kind == "secondary" ? Theme.text-primary : Theme.text-on-accent;
            vertical-alignment: center;
            animate color { duration: 150ms; }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// Spring-animated circular Theme Toggle (Moon <-> Sun vertical morph)
// ---------------------------------------------------------------------------
export component ThemeToggleButton inherits Glass {
    in property <bool> dark: false;
    callback clicked;

    width: 46px;
    height: 46px;
    radius: 23px;
    tint: ta.pressed ? Theme.inner-tile-hover : (ta.has-hover ? Theme.glass-hover : Theme.glass-regular);

    Icon {
        x: 0px;
        y: root.dark ? -46px : (ta.pressed ? 1.5px : 0px);
        width: parent.width;
        height: parent.height;
        text: "\u{e3a8}";
        font-size: 19px;
        color: Theme.text-primary;
        animate y {
            duration: 340ms;
            easing: spring(0.18);
        }
    }

    Icon {
        x: 0px;
        y: root.dark ? (ta.pressed ? 1.5px : 0px) : 46px;
        width: parent.width;
        height: parent.height;
        text: "\u{e430}";
        font-size: 19px;
        color: #FFB84D;
        animate y {
            duration: 340ms;
            easing: spring(0.18);
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---------------------------------------------------------------------------
// iOS 26 Interactive Draggable Liquid Glass Tab Bar (Compact 46px height)
// ---------------------------------------------------------------------------
export component LiquidTabBar inherits Glass {
    in-out property <int> active-tab: 0;
    in property <int> active-mods-count: 0;
    callback tab-selected(int);

    property <bool> dragging: false;
    property <length> drag-pointer-x: 0px;

    function tab-at(mx: length) -> int {
        if mx < t1.x { return 0; }
        if mx < t2.x { return 1; }
        if mx < t3.x { return 2; }
        return 3;
    }

    function tab-x(idx: int) -> length {
        if idx == 0 { return t0.x; }
        if idx == 1 { return t1.x; }
        if idx == 2 { return t2.x; }
        return t3.x;
    }

    function tab-w(idx: int) -> length {
        if idx == 0 { return t0.width; }
        if idx == 1 { return t1.width; }
        if idx == 2 { return t2.width; }
        return t3.width;
    }

    property <int> visual-tab: root.dragging ? root.tab-at(root.drag-pointer-x) : root.active-tab;
    property <int> hover-tab: bar-ta.has-hover ? root.tab-at(bar-ta.mouse-x) : -1;
    property <length> droplet-w: root.tab-w(root.visual-tab);
    property <length> max-droplet-x: Math.max(t0.x, t3.x + t3.width - root.droplet-w);
    property <length> droplet-x: root.dragging
        ? Math.clamp(root.drag-pointer-x - root.droplet-w / 2, t0.x, root.max-droplet-x)
        : root.tab-x(root.active-tab);

    height: 46px;
    radius: 23px;

    Rectangle {
        x: root.droplet-x;
        y: root.dragging ? 4px : 5px;
        width: root.droplet-w;
        height: root.dragging ? 38px : 36px;
        border-radius: self.height / 2;
        background: root.dragging ? Theme.droplet-drag-bg : Theme.droplet-bg;

        animate x {
            duration: root.dragging ? 90ms : 340ms;
            easing: spring(0.16);
        }
        animate width {
            duration: 280ms;
            easing: spring(0.10);
        }
        animate y, height {
            duration: 220ms;
            easing: spring(0.15);
        }
        animate background { duration: 150ms; }
    }

    HorizontalLayout {
        padding: 5px;
        spacing: 2px;

        // Tab 0: Home
        t0 := Rectangle {
            height: 36px;
            border-radius: 18px;
            background: !root.dragging && root.active-tab != 0 && root.hover-tab == 0 ? Theme.droplet-hover : transparent;
            animate background { duration: 120ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 14px;
                padding-right: 16px;

                Icon {
                    text: "\u{e88a}";
                    font-size: 17px;
                    color: root.visual-tab == 0 ? Theme.accent : (root.hover-tab == 0 ? Theme.text-primary : Theme.text-secondary);
                    animate color { duration: 140ms; }
                }
                Text {
                    text: "Главная";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.visual-tab == 0 ? Theme.text-primary : (root.hover-tab == 0 ? Theme.text-primary : Theme.text-secondary);
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
            }
        }

        // Tab 1: Mods
        t1 := Rectangle {
            height: 36px;
            border-radius: 18px;
            background: !root.dragging && root.active-tab != 1 && root.hover-tab == 1 ? Theme.droplet-hover : transparent;
            animate background { duration: 120ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 14px;
                padding-right: 16px;

                Icon {
                    text: "\u{e87b}";
                    font-size: 17px;
                    color: root.visual-tab == 1 ? Theme.accent : (root.hover-tab == 1 ? Theme.text-primary : Theme.text-secondary);
                    animate color { duration: 140ms; }
                }
                Text {
                    text: "Моды";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.visual-tab == 1 ? Theme.text-primary : (root.hover-tab == 1 ? Theme.text-primary : Theme.text-secondary);
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
                if root.active-mods-count > 0: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 17px;
                        min-width: 17px;
                        border-radius: 8.5px;
                        background: Theme.accent;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: "\{root.active-mods-count}";
                                font-size: 10px;
                                font-weight: 700;
                                color: #FFFFFF;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Tab 2: Settings
        t2 := Rectangle {
            height: 36px;
            border-radius: 18px;
            background: !root.dragging && root.active-tab != 2 && root.hover-tab == 2 ? Theme.droplet-hover : transparent;
            animate background { duration: 120ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 14px;
                padding-right: 16px;

                Icon {
                    text: "\u{e8b8}";
                    font-size: 17px;
                    color: root.visual-tab == 2 ? Theme.accent : (root.hover-tab == 2 ? Theme.text-primary : Theme.text-secondary);
                    animate color { duration: 140ms; }
                }
                Text {
                    text: "Настройки";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.visual-tab == 2 ? Theme.text-primary : (root.hover-tab == 2 ? Theme.text-primary : Theme.text-secondary);
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
            }
        }

        // Tab 3: Console
        t3 := Rectangle {
            height: 36px;
            border-radius: 18px;
            background: !root.dragging && root.active-tab != 3 && root.hover-tab == 3 ? Theme.droplet-hover : transparent;
            animate background { duration: 120ms; }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 14px;
                padding-right: 16px;

                Icon {
                    text: "\u{e86f}";
                    font-size: 17px;
                    color: root.visual-tab == 3 ? Theme.accent : (root.hover-tab == 3 ? Theme.text-primary : Theme.text-secondary);
                    animate color { duration: 140ms; }
                }
                Text {
                    text: "Консоль";
                    font-size: 13px;
                    font-weight: 600;
                    color: root.visual-tab == 3 ? Theme.text-primary : (root.hover-tab == 3 ? Theme.text-primary : Theme.text-secondary);
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
            }
        }
    }

    bar-ta := TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-pointer-x = self.mouse-x;
                root.dragging = true;
            } else if event.kind == PointerEventKind.up {
                let target = root.tab-at(self.mouse-x);
                root.dragging = false;
                if target != root.active-tab {
                    root.active-tab = target;
                    root.tab-selected(target);
                }
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed {
                root.drag-pointer-x = self.mouse-x;
            }
        }
    }
}

// Smooth spring-draggable 4-option segmented control
export component LiquidSegmented4 inherits Rectangle {
    in property <string> label0;
    in property <string> label1;
    in property <string> label2;
    in property <string> label3;
    in-out property <int> selected: 0;
    callback changed(int);

    property <bool> dragging: false;
    property <length> drag-pointer-x: 0px;

    function seg-at(mx: length) -> int {
        if mx < s1.x { return 0; }
        if mx < s2.x { return 1; }
        if mx < s3.x { return 2; }
        return 3;
    }

    function seg-x(idx: int) -> length {
        if idx == 0 { return s0.x; }
        if idx == 1 { return s1.x; }
        if idx == 2 { return s2.x; }
        return s3.x;
    }

    function seg-w(idx: int) -> length {
        if idx == 0 { return s0.width; }
        if idx == 1 { return s1.width; }
        if idx == 2 { return s2.width; }
        return s3.width;
    }

    property <int> visual-idx: root.dragging ? root.seg-at(root.drag-pointer-x) : root.selected;
    property <length> cur-w: root.seg-w(root.visual-idx);
    property <length> max-x: Math.max(s0.x, s3.x + s3.width - root.cur-w);
    property <length> droplet-x: root.dragging
        ? Math.clamp(root.drag-pointer-x - root.cur-w / 2, s0.x, root.max-x)
        : root.seg-x(root.selected);

    height: 38px;
    border-radius: 19px;
    background: Theme.fill;
    animate background { duration: 200ms; }

    Rectangle {
        x: root.droplet-x;
        y: root.dragging ? 2px : 3px;
        width: root.cur-w;
        height: root.dragging ? 34px : 32px;
        border-radius: self.height / 2;
        background: root.dragging ? Theme.droplet-drag-bg : Theme.droplet-bg;

        animate x {
            duration: root.dragging ? 85ms : 300ms;
            easing: spring(0.15);
        }
        animate width {
            duration: 240ms;
            easing: spring(0.10);
        }
        animate y, height { duration: 180ms; easing: spring(0.12); }
        animate background { duration: 140ms; }
    }

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;

        s0 := Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            Text {
                text: root.label0;
                font-size: 12.5px;
                font-weight: 600;
                color: root.visual-idx == 0 ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 140ms; }
            }
        }
        s1 := Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            Text {
                text: root.label1;
                font-size: 12.5px;
                font-weight: 600;
                color: root.visual-idx == 1 ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 140ms; }
            }
        }
        s2 := Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            Text {
                text: root.label2;
                font-size: 12.5px;
                font-weight: 600;
                color: root.visual-idx == 2 ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 140ms; }
            }
        }
        s3 := Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            Text {
                text: root.label3;
                font-size: 12.5px;
                font-weight: 600;
                color: root.visual-idx == 3 ? Theme.text-primary : Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: 140ms; }
            }
        }
    }

    TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.drag-pointer-x = self.mouse-x;
                root.dragging = true;
            } else if event.kind == PointerEventKind.up {
                let target = root.seg-at(self.mouse-x);
                root.dragging = false;
                if target != root.selected {
                    root.selected = target;
                    root.changed(target);
                }
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed {
                root.drag-pointer-x = self.mouse-x;
            }
        }
    }
}

