                }
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
        moved => {
            if self.pressed {
                root.drag-pointer-x = self.mouse-x;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Native-spring iOS 26 Toggle
// ---------------------------------------------------------------------------
export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);

    width: 50px;
    height: 30px;
    border-radius: 15px;
    background: checked ? Theme.green : Theme.fill-strong;
    animate background { duration: 200ms; }

    property <length> thumb-w: ta.pressed ? 30px : 26px;

    Rectangle {
        x: root.checked ? parent.width - root.thumb-w - 2px : 2px;
        y: 2px;
        width: root.thumb-w;
        height: 26px;
        border-radius: 13px;
        background: #FFFFFF;

        animate x {
            duration: 280ms;
            easing: spring(0.20);
        }
        animate width {
            duration: 180ms;
            easing: spring(0.12);
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------------------------------------------------------------------
// High-FPS Spring iOS Slider
// ---------------------------------------------------------------------------
export component Slider inherits Rectangle {
    in property <string> title;
    in property <string> icon: "";
    in property <string> value-text;
    in-out property <int> value;
    in property <int> min-val: 2;
    in property <int> max-val: 16;
    in property <int> step: 1;
    callback changed(int);

    property <float> ratio: Math.clamp((root.value - root.min-val) / Math.max(1, root.max-val - root.min-val), 0.0, 1.0);
    property <length> thumb-size: track-ta.pressed ? 28px : (track-ta.has-hover ? 26px : 24px);

    function set-from(mx: length) {
        let frac = Math.clamp((mx - 14px) / Math.max(1px, track.width - 28px), 0.0, 1.0);
        let raw = root.min-val + Math.round(frac * (root.max-val - root.min-val));
        let snapped = root.min-val + Math.round((raw - root.min-val) / Math.max(1, root.step)) * root.step;
        let next-val = Math.clamp(snapped, root.min-val, root.max-val);
        if next-val != root.value {
            root.value = next-val;
            root.changed(root.value);
        }
    }

    height: 62px;

    VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: 17px;
                color: Theme.accent;
            }
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
                animate color { duration: 200ms; }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.value-text;
                font-size: 13px;
                font-weight: 700;
                color: Theme.accent-label;
                vertical-alignment: center;
                animate color { duration: 180ms; }
            }
        }

        track := Rectangle {
            height: 28px;

            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 5px;
                border-radius: 2.5px;
                background: Theme.fill-strong;
                animate background { duration: 180ms; }
            }

            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 12px + (parent.width - 24px) * root.ratio;
                height: 5px;
                border-radius: 2.5px;
                background: @linear-gradient(90deg, #FFA45C 0%, #FF6A1F 100%);
                animate width { duration: 110ms; easing: spring(0.0); }
            }

            Rectangle {
                x: (parent.width - root.thumb-size) * root.ratio;
                y: (parent.height - root.thumb-size) / 2;
                width: root.thumb-size;
                height: root.thumb-size;
                border-radius: root.thumb-size / 2;
                background: #FFFFFF;
                animate x { duration: 110ms; easing: spring(0.0); }
                animate width, height, y { duration: 180ms; easing: spring(0.15); }
            }

            track-ta := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.set-from(self.mouse-x);
                    }
                }
                moved => { root.set-from(self.mouse-x); }
            }
        }
    }
}

// Glass text field
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> icon: "";
    in property <length> field-height: 44px;
    callback accepted;
    callback edited;

    height: field-height;
    border-radius: self.height / 2;
    background: input.has-focus ? Theme.field-bg-focus : Theme.field-bg;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-border;
    animate background, border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 9px;

        if root.icon != "": Icon {
            text: root.icon;
            font-size: 18px;
            color: input.has-focus ? Theme.accent : Theme.text-muted;
            animate color { duration: 150ms; }
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-size: 13.5px;
                color: Theme.text-muted;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                animate color { duration: 200ms; }
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                font-size: 13.5px;
                color: Theme.text-primary;
                selection-background-color: #FF6A1F55;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
        }
    }
}

// Compact settings row with switch
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in-out property <bool> checked;
    callback toggled(bool);

    height: 58px;
    border-radius: 16px;
    background: row-ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile;
    animate background { duration: 150ms; }

    row-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Icon {
                text: root.icon;
                font-size: 20px;
                color: Theme.accent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: 600;
                color: Theme.text-primary;
                animate color { duration: 200ms; }
            }
            Text {
                text: root.subtitle;
                font-size: 11.5px;
                color: Theme.text-muted;
                overflow: elide;
                animate color { duration: 200ms; }
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                checked <=> root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

// Visual 16:9 wallpaper preview tile for Settings
export component WallpaperTile inherits Rectangle {
    in property <string> label;
    in property <image> preview;
    in property <bool> has-preview: true;
    in property <bool> selected: false;
    in property <string> fallback-icon: "\u{e43e}";
    callback clicked;

    height: 70px;
    border-radius: 14px;
    clip: true;
    background: ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile;
    animate background { duration: 140ms; }

    if root.has-preview: Image {
        width: 100%;
        height: 100%;
        source: root.preview;
        image-fit: cover;
    }

    if !root.has-preview: VerticalLayout {
        alignment: center;
        padding-bottom: 14px;
        Icon {
            text: root.fallback-icon;
            font-size: 22px;
            color: root.selected ? Theme.accent : Theme.text-secondary;
        }
    }

    // Soft bottom label scrim
    Rectangle {
        y: parent.height - 26px;
        width: parent.width;
        height: 26px;
        background: root.has-preview
            ? @linear-gradient(180deg, #00000000 0%, #070A12CC 100%)
            : transparent;
    }

    Text {
        x: 6px;
        y: parent.height - 21px;
        width: parent.width - 12px;
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: root.has-preview ? #FFFFFF : Theme.text-primary;
        horizontal-alignment: center;
        overflow: elide;
    }

    // Active orange selection border
    Rectangle {
        border-radius: root.border-radius;
        border-width: root.selected ? 2.5px : (ta.has-hover ? 1px : 0px);
        border-color: root.selected ? Theme.accent : Theme.field-border;
        background: transparent;
        animate border-width, border-color { duration: 150ms; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
