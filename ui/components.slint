            horizontal-stretch: root.stretch ? 1 : 0;
            height: 32px;
            HorizontalLayout {
                alignment: center;
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: root.label1;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: root.visual-idx == 1 ? Theme.text-primary : Theme.text-secondary;
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
            }
        }
        f2 := Rectangle {
            horizontal-stretch: root.stretch ? 1 : 0;
            height: 32px;
            HorizontalLayout {
                alignment: center;
