import { ScrollView, ListView } from "std-widgets.slint";
import { Backdrop, Theme } from "theme.slint";
import {
    Icon,
    Glass,
    GlassButton,
    ThemeToggleButton,
    LiquidTabBar,
    LiquidSegmented4,
    LiquidSegmented3,
    LiquidSegmented2,
    Toggle,
    Slider,
    Field,
    SettingRow,
    WallpaperTile,
} from "components.slint";

import "../src/GoogleSans-Regular.ttf";
import "../src/GoogleSans-Medium.ttf";
import "../src/GoogleSans-Bold.ttf";
import "../src/MaterialIcons-Regular.ttf";

export { Backdrop, Theme } from "theme.slint";

export struct ModInfo {
    name: string,
    file-name: string,
    size-kb: int,
    enabled: bool,
    is-shader: bool,
    is-resourcepack: bool,
    has-icon: bool,
    icon: image,
}

export struct CatalogModInfo {
    id: string,
    name: string,
    description: string,
    version: string,
    file-name: string,
    size-kb: int,
    installed: bool,
    downloading: bool,
    has-icon: bool,
    icon: image,
    is-shader: bool,
    is-resourcepack: bool,
}

export struct LogEntry {
    text: string,
    color: color,
    level: int, // 0 = info, 1 = warn, 2 = error
}

export component AppWindow inherits Window {
    title: "Horizon Offline — 26.3";
    icon: Backdrop.tinted-icon;
    default-font-family: "Google Sans";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 920px;
    min-height: 620px;
    background: Theme.dark ? #11131A : #C9A68A;

    init => {
        Backdrop.win-width = self.width;
        Backdrop.win-height = self.height;
    }
    changed width => { Backdrop.win-width = self.width; }
    changed height => { Backdrop.win-height = self.height; }

    // Navigation state
    in-out property <int> active-tab: 0; // 0 Home, 1 Mods, 2 Settings, 3 Console
    in-out property <int> mods-view: 0;  // 0 Catalog, 1 Installed
    property <int> log-filter: 0;        // 0 all, 1 warn+, 2 errors

    // Launcher state (synced with Rust ui_bridge)
    in-out property <string> nickname: "";
    in-out property <int> ram-gb: 4;
    in-out property <int> render-distance: 12;
    in-out property <int> window-width: 1280;
    in-out property <int> window-height: 720;
    in-out property <bool> fullscreen: false;
    in-out property <bool> creative-mode: false;
    in-out property <bool> dark-mode: false;
    in-out property <int> backdrop-index: 0; // 0 abstract, 1 aurora, 2 cherry, 3 sunset, 4 custom
    in-out property <string> server-address: "";
    in-out property <bool> is-playing: false;
    in-out property <string> mods-dir-path: "";
    in-out property <bool> client-ready: false;
    in-out property <bool> has-embedded-payload: false;
    in-out property <[string]> recent-nicknames: [];

    in-out property <[ModInfo]> mods: [];
    in-out property <int> active-mods-count: 0;
    in-out property <int> total-mods-count: 0;
    in-out property <[CatalogModInfo]> catalog-mods: [];
    in-out property <bool> catalog-loading: false;
    in-out property <string> catalog-error: "";
    in-out property <string> catalog-search: "";
    in-out property <int> catalog-filter: 0; // 0 all, 1 shaders, 2 pvp packs
    in-out property <string> mods-repo-url: "";
    in-out property <[LogEntry]> log-lines: [];

    in-out property <string> edit-nickname: "";
    in-out property <bool> play-after-nickname: false;
    in-out property <bool> show-account-dialog: false;

    in-out property <string> status-text: "";
    in-out property <bool> status-is-error: false;
    in-out property <bool> has-status-message: false;

    in-out property <bool> is-unpacking: false;
    in-out property <float> unpack-progress: 0.0;
    in-out property <string> unpack-status: "Подготовка к распаковке...";
    in-out property <string> unpack-percent-text: "0%";
    in-out property <string> unpack-time-left: "";
    in-out property <bool> unpack-has-error: false;
    in-out property <string> unpack-error-text: "";

    in-out property <string> app-version: "2.1.0";
    in-out property <bool> show-update-dialog: false;
    in-out property <string> update-new-version: "";
    in-out property <string> update-notes: "";
    in-out property <string> update-size-text: "";
    in-out property <bool> update-downloading: false;
    in-out property <float> update-progress: 0.0;
    in-out property <string> update-status-text: "";
    in-out property <string> update-percent-text: "0%";
    in-out property <string> update-error-text: "";
    in-out property <bool> update-checking: false;

    callback play();
    callback stop();
    callback open-mods-folder();
    callback open-saves-folder();
    callback open-screenshots-folder();
    callback open-game-folder();
    callback refresh-mods();
    callback toggle-mod(string);
    callback delete-mod(string);
    callback refresh-catalog();
    callback search-catalog(string);
    callback filter-catalog(int);
    callback download-mod(string);
    callback save-settings();
    callback select-backdrop(int);
    callback pick-custom-backdrop();
    callback set-nickname(string);
    callback clear-log();
    callback repair-client();
    callback check-updates();
    callback start-update();
    callback cancel-update();
    callback retry-unpack();

    function resolution-index() -> int {
        if root.window-width == 1600 && root.window-height == 900 { return 1; }
        if root.window-width == 1920 && root.window-height == 1080 { return 2; }
        if root.window-width == 2560 && root.window-height == 1440 { return 3; }
        return 0;
    }

    function perf-preset-index() -> int {
        if root.ram-gb <= 3 && root.render-distance <= 10 { return 0; }
        if root.ram-gb >= 8 || root.render-distance >= 18 { return 2; }
        return 1;
    }

    function apply-dark-mode(next: bool) {
        root.dark-mode = next;
        Theme.dark = next;
        root.save-settings();
    }

    function commit-nickname() {
        if root.edit-nickname != "" {
            root.nickname = root.edit-nickname;
            root.set-nickname(root.edit-nickname);
            root.show-account-dialog = false;
            if root.play-after-nickname {
                root.play-after-nickname = false;
                root.play();
            }
        }
    }

    // =====================================================================
    // Full-bleed Wallpaper Canvas
    // =====================================================================
    Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: Backdrop.sharp;
        image-fit: cover;
    }

    // Soft atmospheric scrim (pure clean Minecraft art on Home, frosted dark dim on content tabs)
    Rectangle {
        background: root.active-tab == 0
            ? (Theme.dark ? #070A1228 : #00000000)
            : Theme.wallpaper-dim;
        animate background {
            duration: 240ms;
            easing: ease-out;
        }
    }

    Rectangle {
        background: root.active-tab == 0
            ? @linear-gradient(180deg, #070A1230 0%, #00000000 22%, #00000000 66%, #070A1288 100%)
            : @linear-gradient(180deg, #00000014 0%, #00000000 32%, #00000000 70%, #00000028 100%);
    }

    // =====================================================================
    // Edge-to-Edge Full-Window Shell
    // =====================================================================
    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // ---------------- Slim Floating Top Bar ----------------
        HorizontalLayout {
            height: 46px;
            spacing: 10px;

            Glass {
                horizontal-stretch: 0;
                height: 46px;
                radius: 23px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 16px;
                    spacing: 9px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 7px;
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: Backdrop.tinted-icon;
                                image-fit: cover;
                            }
                        }
                    }

                    Text {
                        text: "Horizon";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        animate color { duration: 200ms; }
                    }
                    Text {
                        text: "26.3";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.accent-label;
                        vertical-alignment: center;
                        animate color { duration: 200ms; }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            LiquidTabBar {
                horizontal-stretch: 0;
                active-tab <=> root.active-tab;
                active-mods-count: root.active-mods-count;
                tab-selected(idx) => {
                    if idx == 1 {
                        root.refresh-mods();
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            ThemeToggleButton {
                horizontal-stretch: 0;
                dark: Theme.dark;
                clicked => { root.apply-dark-mode(!root.dark-mode); }
            }

            Glass {
                horizontal-stretch: 0;
                height: 46px;
                radius: 23px;
                tint: profile-ta.pressed ? Theme.inner-tile-hover : (profile-ta.has-hover ? Theme.glass-hover : Theme.glass-regular);

                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 15px;
                    padding-top: profile-ta.pressed ? 1.5px : 0px;
                    spacing: 9px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: Theme.accent;
                            animate background { duration: 220ms; }
                            Icon {
                                text: "\u{e7fd}";
                                font-size: 18px;
                                color: #FFFFFF;
                            }
                        }
                    }

                    Text {
                        text: root.nickname == "" ? "Войти" : root.nickname;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                        animate color { duration: 200ms; }
                    }
                }

                profile-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.edit-nickname = root.nickname;
                        root.play-after-nickname = false;
                        root.show-account-dialog = true;
                    }
                }
            }
        }

        // ---------------- Spring 144Hz Full-Window Stage ----------------
        stage := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;

            // =================================================================
            // PAGE 0: HOME — Authentic Native Minecraft Desktop Launcher Layout
            // Full-bleed in-game Minecraft showcase + Grounded Launch Bar
            // =================================================================
            Rectangle {
                x: 0px;
                y: root.active-tab == 0 ? 0px : 14px;
                width: stage.width;
                height: stage.height;
                visible: root.active-tab == 0;
                background: transparent;

                animate y {
                    duration: 300ms;
                    easing: spring(0.14);
                }

                VerticalLayout {
                    spacing: 10px;

                    // Pure unobstructed Minecraft world art
                    Rectangle { vertical-stretch: 1; }

                    // Conditional inline error / status notification
                    if root.has-status-message: Rectangle {
                        border-radius: 12px;
                        background: root.status-is-error ? #7A1412E0 : #115E28E0;
                        HorizontalLayout {
                            padding: 11px;
                            spacing: 8px;
                            Icon {
                                text: root.status-is-error ? "\u{e000}" : "\u{e86c}";
                                font-size: 18px;
                                color: #FFFFFF;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: root.status-text;
                                font-size: 13px;
                                color: #FFFFFF;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Grounded Desktop Game Launch Bar (Official Minecraft / Steam / Modrinth style)
                    Glass {
                        width: 100%;
                        height: 82px;
                        radius: 16px;
                        tint: Theme.glass-thick;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 14px;

                            // Left: Game Edition + Profile Summary (clickable -> Settings)
                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 46px;
                                        height: 46px;
                                        border-radius: 10px;
                                        clip: true;
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: Backdrop.tinted-icon;
                                            image-fit: cover;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;

                                    HorizontalLayout {
                                        spacing: 7px;
                                        alignment: start;
                                        Text {
                                            text: "Minecraft 26.3";
                                            font-size: 15px;
                                            font-weight: 700;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                height: 20px;
                                                border-radius: 6px;
                                                background: Theme.badge-pill-bg;
                                                HorizontalLayout {
                                                    padding-left: 7px;
                                                    padding-right: 7px;
                                                    spacing: 5px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 6px;
                                                            height: 6px;
                                                            border-radius: 3px;
                                                            background: root.is-playing ? Theme.blue : (root.client-ready ? Theme.green : Theme.amber);
                                                        }
                                                    }
                                                    Text {
                                                        text: root.is-playing ? "В игре" : "Horizon";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.text-secondary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "\{root.ram-gb} ГБ ОЗУ · \{root.render-distance} чанков · "
                                            + (root.active-mods-count > 0 ? "Модов: \{root.active-mods-count}" : "Без модов");
                                        font-size: 12px;
                                        color: Theme.text-muted;
                                    }
                                }
                            }

                            // Vertical hairline divider
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 1px;
                                    height: 36px;
                                    background: Theme.fill;
                                }
                            }

                            // Compact Optional Server Address input (crisp rounded rectangle, not bubbly pill)
                            VerticalLayout {
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                alignment: center;

                                Rectangle {
                                    height: 44px;
                                    border-radius: 11px;
                                    background: srv-in.has-focus ? Theme.field-bg-focus : Theme.field-bg;
                                    border-width: srv-in.has-focus ? 1.5px : 1px;
                                    border-color: srv-in.has-focus ? Theme.accent : Theme.field-border;
                                    animate background, border-color { duration: 150ms; }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Icon {
                                            text: "\u{e875}";
                                            font-size: 18px;
                                            color: srv-in.has-focus ? Theme.accent : Theme.text-muted;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            if root.server-address == "": Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "IP сервера (необязательно)";
                                                font-size: 13px;
                                                color: Theme.text-muted;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            srv-in := TextInput {
                                                width: 100%;
                                                height: 100%;
                                                text <=> root.server-address;
                                                font-size: 13px;
                                                color: Theme.text-primary;
                                                selection-background-color: Theme.accent-selection;
                                                vertical-alignment: center;
                                                single-line: true;
                                                accepted => { root.play(); }
                                                edited => { root.save-settings(); }
                                            }
                                        }
                                    }
                                }
                            }

                            // Quiet compact utility buttons (crisp 11px desktop radius)
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 11px;
                                        background: fld-ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile;
                                        animate background { duration: 140ms; }
                                        Icon { text: "\u{e2c8}"; font-size: 20px; color: Theme.text-primary; }
                                        fld-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open-game-folder(); }
                                        }
                                    }

                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 11px;
                                        background: log-ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile;
                                        animate background { duration: 140ms; }
                                        Icon { text: "\u{e86f}"; font-size: 20px; color: Theme.text-primary; }
                                        log-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.active-tab = 3; }
                                        }
                                    }
                                }
                            }

                            // Grounded Authentic Game Launch Button (crisp 12px desktop radius)
                            VerticalLayout {
                                alignment: center;
                                play-cta := Rectangle {
                                    width: 196px;
                                    height: 48px;
                                    border-radius: 12px;
                                    opacity: (root.is-playing || !root.is-unpacking) ? 1.0 : 0.45;
                                    background: root.is-playing
                                        ? (play-ta.pressed ? #C8231AF2 : (play-ta.has-hover ? #FF574DF5 : #FF3B30F0))
                                        : (play-ta.pressed ? Theme.accent-pressed : (play-ta.has-hover ? Theme.accent-hover : Theme.accent));
                                    animate background { duration: 150ms; }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        padding-top: play-ta.pressed ? 1px : 0px;

                                        Icon {
                                            text: root.is-playing ? "\u{e047}" : "\u{e037}";
                                            font-size: 22px;
                                            color: #FFFFFF;
                                        }
                                        Text {
                                            text: root.is-playing ? "Остановить" : "Играть";
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: #FFFFFF;
                                            vertical-alignment: center;
                                        }
                                    }

                                    play-ta := TouchArea {
                                        enabled: root.is-playing || !root.is-unpacking;
                                        mouse-cursor: self.enabled ? pointer : default;
                                        clicked => {
                                            if root.is-playing {
                                                root.stop();
                                            } else {
                                                root.play();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =================================================================
            // PAGE 1: MODS — Full-Window 100% Width, 3 Clean Filters, Zero Clipping
            // =================================================================
            Rectangle {
                x: 0px;
                y: root.active-tab == 1 ? 0px : 14px;
                width: stage.width;
                height: stage.height;
                visible: root.active-tab == 1;
                background: transparent;

                animate y {
                    duration: 300ms;
                    easing: spring(0.14);
                }

                Glass {
                    width: 100%;
                    height: 100%;
                    radius: 28px;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        // Responsive full-width top toolbar (zero overflow at any width!)
                        HorizontalLayout {
                            height: 40px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                LiquidSegmented2 {
                                    width: 244px;
                                    label0: "Каталог";
                                    label1: "Мои (\{root.total-mods-count})";
                                    selected <=> root.mods-view;
                                    changed(v) => {
                                        if v == 1 {
                                            root.refresh-mods();
                                        }
                                    }
                                }
                            }

                            if root.mods-view == 0: VerticalLayout {
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                alignment: center;
                                Field {
                                    preferred-width: 0px;
                                    field-height: 40px;
                                    icon: "\u{e8b6}";
                                    text <=> root.catalog-search;
                                    placeholder: "Поиск шейдеров и паков...";
                                    edited => { root.search-catalog(root.catalog-search); }
                                }
                            }

                            if root.mods-view == 1: HorizontalLayout {
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                padding-left: 6px;
                                Text {
                                    text: "Активно \{root.active-mods-count} из \{root.total-mods-count} · .hshader .zip";
                                    font-size: 13px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                GlassButton {
                                    btn-height: 40px;
                                    icon: "\u{e5d5}";
                                    text: "";
                                    enabled: root.mods-view == 1 || !root.catalog-loading;
                                    clicked => {
                                        if root.mods-view == 0 {
                                            root.refresh-catalog();
                                        } else {
                                            root.refresh-mods();
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                GlassButton {
                                    btn-height: 40px;
                                    icon: "\u{e2c8}";
                                    text: "Папка";
                                    clicked => { root.open-mods-folder(); }
                                }
                            }
                        }

                        // Catalog Category Filter Row (3 clean client-side categories)
                        if root.mods-view == 0: HorizontalLayout {
                            height: 38px;
                            spacing: 12px;

                            LiquidSegmented3 {
                                width: 330px;
                                stretch: true;
                                label0: "Все";
                                label1: "Шейдеры";
                                label2: "Паки";
                                selected <=> root.catalog-filter;
                                changed(idx) => { root.filter-catalog(idx); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.catalog-loading ? "Загрузка с GitHub..." : "Доступно: \{root.catalog-mods.length}";
                                font-size: 12px;
                                font-weight: 500;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        // Error notice
                        if root.mods-view == 0 && root.catalog-error != "": Rectangle {
                            border-radius: 16px;
                            background: #FF3B301E;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Icon {
                                    text: "\u{e000}";
                                    font-size: 18px;
                                    color: Theme.red;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    text: root.catalog-error;
                                    font-size: 12px;
                                    color: Theme.dark ? #FF8A80 : #B0000F;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // --- CATALOG VIEW ---
                        if root.mods-view == 0 && !root.catalog-loading && root.catalog-mods.length == 0: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 20px;
                            background: Theme.inner-tile-disabled;

                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding: 24px;

                                Icon {
                                    text: "\u{e2c0}";
                                    font-size: 40px;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    text: root.catalog-search != "" ? "Ничего не найдено" : "Каталог пока пуст";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.catalog-search != ""
                                        ? "Попробуй изменить запрос или фильтр категории"
                                        : "Проверь подключение или нажми «Обновить»";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    GlassButton {
                                        btn-height: 38px;
                                        icon: "\u{e8b8}";
                                        text: "Настроить URL";
                                        clicked => { root.active-tab = 2; }
                                    }
                                    GlassButton {
                                        btn-height: 38px;
                                        kind: "primary";
                                        icon: "\u{e5d5}";
                                        text: "Повторить";
                                        clicked => { root.refresh-catalog(); }
                                    }
                                }
                            }
                        }

                        if root.mods-view == 0 && root.catalog-mods.length > 0: cat-lv := ListView {
                            vertical-stretch: 1;

                            for cmod in root.catalog-mods: Rectangle {
                                width: cat-lv.visible-width;
                                height: 82px;
                                background: transparent;

                                Rectangle {
                                    x: 0px;
                                    y: 2px;
                                    width: Math.max(0px, parent.width - 8px);
                                    height: 74px;
                                    border-radius: 18px;
                                    background: card-ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile;
                                    clip: true;

                                    card-ta := TouchArea { }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 14px;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 48px;
                                                height: 48px;
                                                border-radius: 13px;
                                                background: Theme.badge-pill-bg;
                                                clip: true;

                                                if cmod.has-icon: Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: cmod.icon;
                                                    image-fit: cover;
                                                }

                                                if !cmod.has-icon: Icon {
                                                    text: cmod.is-shader ? "\u{e3a5}" : (cmod.is-resourcepack ? "\u{e3ae}" : "\u{e87b}");
                                                    font-size: 24px;
                                                    color: Theme.accent;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            alignment: center;
                                            spacing: 4px;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;
                                                Text {
                                                    text: cmod.name;
                                                    font-size: 14px;
                                                    font-weight: 700;
                                                    color: Theme.text-primary;
                                                    overflow: elide;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        height: 20px;
                                                        border-radius: 10px;
                                                        background: Theme.badge-pill-bg;
                                                        HorizontalLayout {
                                                            padding-left: 8px;
                                                            padding-right: 8px;
                                                            Text {
                                                                text: cmod.is-shader ? "Шейдер" : (cmod.is-resourcepack ? "Пак" : "Мод");
                                                                font-size: 11px;
                                                                font-weight: 600;
                                                                color: Theme.text-secondary;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: cmod.description != "" ? cmod.description : cmod.file-name;
                                                font-size: 12px;
                                                color: Theme.text-secondary;
                                                overflow: elide;
                                            }
                                        }

                                        if cmod.size-kb > 0: VerticalLayout {
                                            alignment: center;
                                            Text {
                                                min-width: 54px;
                                                text: cmod.size-kb >= 1024 ? "\{Math.round(cmod.size-kb / 102.4) / 10} МБ" : "\{cmod.size-kb} КБ";
                                                font-size: 12px;
                                                color: Theme.text-muted;
                                                horizontal-alignment: right;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                GlassButton {
                                                    min-width: 118px;
                                                    btn-height: 36px;
                                                    kind: cmod.installed ? "secondary" : "primary";
                                                    icon: cmod.installed ? "\u{e86c}" : (cmod.downloading ? "\u{e86a}" : "\u{e2c4}");
                                                    text: cmod.installed ? "Установлен" : (cmod.downloading ? "..." : "Скачать");
                                                    enabled: !cmod.installed && !cmod.downloading;
                                                    clicked => { root.download-mod(cmod.id); }
                                                }
                                                if cmod.installed: Rectangle {
                                                    width: 36px;
                                                    height: 36px;
                                                    border-radius: 18px;
                                                    background: cat-del-ta.has-hover ? #FF3B3030 : Theme.fill;
                                                    border-width: 1px;
                                                    border-color: cat-del-ta.has-hover ? #FF3B3060 : Theme.fill-strong;
                                                    Icon {
                                                        text: "\u{e872}";
                                                        font-size: 18px;
                                                        color: cat-del-ta.has-hover ? Theme.red : Theme.text-secondary;
                                                    }
                                                    cat-del-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.delete-mod(cmod.file-name); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // --- INSTALLED MODS VIEW ---
                        if root.mods-view == 1 && root.mods.length == 0: Rectangle {
                            vertical-stretch: 1;
                            border-radius: 20px;
                            background: Theme.inner-tile-disabled;

                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding: 24px;

                                Icon {
                                    text: "\u{e87b}";
                                    font-size: 42px;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    text: "Пока нет установленных модов";
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Выбери нужные шейдеры и PvP-паки в каталоге";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    GlassButton {
                                        btn-height: 40px;
                                        kind: "primary";
                                        icon: "\u{e8b6}";
                                        text: "Открыть каталог";
                                        clicked => { root.mods-view = 0; }
                                    }
                                }
                            }
                        }

                        if root.mods-view == 1 && root.mods.length > 0: my-lv := ListView {
                            vertical-stretch: 1;

                            for item in root.mods: Rectangle {
                                width: my-lv.visible-width;
                                height: 72px;
                                background: transparent;

                                Rectangle {
                                    x: 0px;
                                    y: 2px;
                                    width: Math.max(0px, parent.width - 8px);
                                    height: 64px;
                                    border-radius: 18px;
                                    clip: true;
                                    background: mod-ta.has-hover
                                        ? Theme.inner-tile-hover
                                        : (item.enabled ? Theme.inner-tile : Theme.inner-tile-disabled);

                                    mod-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-mod(item.file-name); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 44px;
                                                height: 44px;
                                                border-radius: 12px;
                                                clip: true;
                                                background: item.has-icon
                                                    ? Theme.badge-pill-bg
                                                    : (item.enabled
                                                        ? (item.is-shader
                                                            ? @linear-gradient(135deg, #5AC8FA 0%, #5856D6 100%)
                                                            : (item.is-resourcepack
                                                                ? @linear-gradient(135deg, #34C759 0%, #0D9488 100%)
                                                                : @linear-gradient(135deg, #FFA45C 0%, #FF6A1F 100%)))
                                                        : @linear-gradient(135deg, #8E8E93 0%, #636366 100%));

                                                if item.has-icon: Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: item.icon;
                                                    image-fit: cover;
                                                    opacity: item.enabled ? 1.0 : 0.45;
                                                }

                                                if !item.has-icon: Icon {
                                                    text: item.is-shader ? "\u{e3a5}" : (item.is-resourcepack ? "\u{e3ae}" : "\u{e87b}");
                                                    font-size: 20px;
                                                    color: #FFFFFF;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            preferred-width: 0px;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: item.name;
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: item.enabled ? Theme.text-primary : Theme.text-muted;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: (item.is-shader ? "Шейдер · " : (item.is-resourcepack ? "Пак · " : "Мод · "))
                                                    + (item.size-kb >= 1024 ? "\{Math.round(item.size-kb / 102.4) / 10} МБ · " : "\{item.size-kb} КБ · ")
                                                    + (item.enabled ? "включён" : "выключен");
                                                font-size: 12px;
                                                color: Theme.text-muted;
                                                overflow: elide;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                border-radius: 17px;
                                                background: del-ta.has-hover ? #FF3B3028 : transparent;
                                                Icon {
                                                    text: "\u{e872}";
                                                    font-size: 18px;
                                                    color: del-ta.has-hover ? Theme.red : Theme.text-muted;
                                                }
                                                del-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.delete-mod(item.file-name); }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                checked: item.enabled;
                                                toggled(_) => { root.toggle-mod(item.file-name); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =================================================================
            // PAGE 2: SETTINGS — Full-Window 100% Clean Layout (Zero Side Gaps!)
            // =================================================================
            Rectangle {
                x: 0px;
                y: root.active-tab == 2 ? 0px : 14px;
                width: stage.width;
                height: stage.height;
                visible: root.active-tab == 2;
                background: transparent;

                animate y {
                    duration: 300ms;
                    easing: spring(0.14);
                }

                Glass {
                    width: 100%;
                    height: 100%;
                    radius: 28px;

                    set-sv := ScrollView {
                        content-width: set-sv.visible-width;

                        VerticalLayout {
                            width: set-sv.visible-width;
                            alignment: start;
                            padding: 24px;
                            spacing: 18px;

                            // Section 0: Full-width Wallpaper Picker
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    Text {
                                        text: "Фон лаунчера";
                                        font-size: 17px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    GlassButton {
                                        btn-height: 34px;
                                        icon: "\u{e43e}";
                                        text: "Выбрать файл…";
                                        clicked => { root.pick-custom-backdrop(); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    WallpaperTile {
                                        horizontal-stretch: 1;
                                        height: 82px;
                                        label: "Ночь";
                                        preview: @image-url("../assets/thumb-blue.jpg");
                                        selected: root.backdrop-index == 0;
                                        clicked => { root.select-backdrop(0); }
                                    }
                                    WallpaperTile {
                                        horizontal-stretch: 1;
                                        height: 82px;
                                        label: "Долина";
                                        preview: @image-url("../assets/thumb-aurora.jpg");
                                        selected: root.backdrop-index == 1;
                                        clicked => { root.select-backdrop(1); }
                                    }
                                    WallpaperTile {
                                        horizontal-stretch: 1;
                                        height: 82px;
                                        label: "Пещеры";
                                        preview: @image-url("../assets/thumb-dusk.jpg");
                                        selected: root.backdrop-index == 2;
                                        clicked => { root.select-backdrop(2); }
                                    }
                                    WallpaperTile {
                                        horizontal-stretch: 1;
                                        height: 82px;
                                        label: "Рассвет";
                                        preview: @image-url("../assets/thumb-sunset.jpg");
                                        selected: root.backdrop-index == 3;
                                        clicked => { root.select-backdrop(3); }
                                    }
                                    WallpaperTile {
                                        horizontal-stretch: 1;
                                        height: 82px;
                                        label: "Свой фон";
                                        preview: Backdrop.custom-thumb;
                                        has-preview: Backdrop.has-custom-thumb;
                                        selected: root.backdrop-index == 4;
                                        clicked => {
                                            if Backdrop.has-custom-thumb && root.backdrop-index != 4 {
                                                root.select-backdrop(4);
                                            } else {
                                                root.pick-custom-backdrop();
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.fill; }

                            // Balanced full-width 2-column core settings (identical 38px header baseline!)
                            HorizontalLayout {
                                spacing: 26px;

                                // Left: Performance
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        height: 38px;
                                        Text {
                                            text: "Производительность";
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        LiquidSegmented3 {
                                            label0: "Эконом";
                                            label1: "Баланс";
                                            label2: "Ультра";
                                            selected: root.perf-preset-index();
                                            changed(idx) => {
                                                if idx == 0 { root.ram-gb = 2; root.render-distance = 8; }
                                                if idx == 1 { root.ram-gb = 4; root.render-distance = 12; }
                                                if idx == 2 { root.ram-gb = 8; root.render-distance = 20; }
                                                root.save-settings();
                                            }
                                        }
                                    }

                                    Slider {
                                        icon: "\u{e322}";
                                        title: "Оперативная память";
                                        value-text: "\{root.ram-gb} ГБ";
                                        value <=> root.ram-gb;
                                        min-val: 2;
                                        max-val: 16;
                                        step: 1;
                                        changed(_) => { root.save-settings(); }
                                    }

                                    Slider {
                                        icon: "\u{e3f7}";
                                        title: "Дальность прорисовки";
                                        value-text: "\{root.render-distance} чанков";
                                        value <=> root.render-distance;
                                        min-val: 4;
                                        max-val: 32;
                                        step: 2;
                                        changed(_) => { root.save-settings(); }
                                    }
                                }

                                // Right: Display & Gameplay
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    preferred-width: 0px;
                                    spacing: 12px;

                                    HorizontalLayout {
                                        height: 38px;
                                        Text {
                                            text: "Экран и игра";
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text {
                                            text: "\{root.window-width} × \{root.window-height}";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }

                                    LiquidSegmented4 {
                                        label0: "720p";
                                        label1: "900p";
                                        label2: "1080p";
                                        label3: "1440p";
                                        selected: root.resolution-index();
                                        changed(idx) => {
                                            if idx == 0 { root.window-width = 1280; root.window-height = 720; }
                                            if idx == 1 { root.window-width = 1600; root.window-height = 900; }
                                            if idx == 2 { root.window-width = 1920; root.window-height = 1080; }
                                            if idx == 3 { root.window-width = 2560; root.window-height = 1440; }
                                            root.save-settings();
                                        }
                                    }

                                    SettingRow {
                                        icon: "\u{e5d0}";
                                        title: "Полный экран";
                                        subtitle: "Запуск сразу на весь монитор";
                                        checked <=> root.fullscreen;
                                        toggled(_) => { root.save-settings(); }
                                    }

                                    SettingRow {
                                        icon: "\u{e3ae}";
                                        title: "Творческий режим";
                                        subtitle: "Передаёт флаг --creative при запуске";
                                        checked <=> root.creative-mode;
                                        toggled(_) => { root.save-settings(); }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.fill; }

                            // Bottom Full-Width Catalog & Files Row
                            VerticalLayout {
                                spacing: 10px;

                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 10px;
                                    Text {
                                        text: "Каталог и файлы";
                                        font-size: 16px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        GlassButton {
                                            btn-height: 32px;
                                            icon: "\u{e923}";
                                            text: root.update-checking ? "Проверка..." : "Обновления · v\{root.app-version}";
                                            enabled: !root.update-checking && !root.update-downloading;
                                            clicked => { root.check-updates(); }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    Field {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        field-height: 42px;
                                        icon: "\u{e80b}";
                                        text <=> root.mods-repo-url;
                                        placeholder: "https://github.com/user/horizon-mods";
                                        accepted => {
                                            root.save-settings();
                                            root.refresh-catalog();
                                        }
                                        edited => { root.save-settings(); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        GlassButton {
                                            btn-height: 42px;
                                            kind: "primary";
                                            icon: "\u{e5d5}";
                                            text: "Обновить";
                                            clicked => {
                                                root.save-settings();
                                                root.refresh-catalog();
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    GlassButton {
                                        horizontal-stretch: 1;
                                        btn-height: 38px;
                                        icon: "\u{e2c8}";
                                        text: "Папка игры";
                                        clicked => { root.open-game-folder(); }
                                    }
                                    GlassButton {
                                        horizontal-stretch: 1;
                                        btn-height: 38px;
                                        icon: "\u{e87b}";
                                        text: "Моды";
                                        clicked => { root.open-mods-folder(); }
                                    }
                                    GlassButton {
                                        horizontal-stretch: 1;
                                        btn-height: 38px;
                                        icon: "\u{e80b}";
                                        text: "Миры";
                                        clicked => { root.open-saves-folder(); }
                                    }
                                    GlassButton {
                                        horizontal-stretch: 1;
                                        btn-height: 38px;
                                        icon: "\u{e412}";
                                        text: "Скриншоты";
                                        clicked => { root.open-screenshots-folder(); }
                                    }
                                    if root.has-embedded-payload: GlassButton {
                                        horizontal-stretch: 1;
                                        btn-height: 38px;
                                        icon: "\u{e869}";
                                        text: "Восстановить";
                                        enabled: !root.is-playing && !root.is-unpacking;
                                        clicked => { root.repair-client(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // =================================================================
            // PAGE 3: CONSOLE — Full-Window Log Viewer
            // =================================================================
            Rectangle {
                x: 0px;
                y: root.active-tab == 3 ? 0px : 14px;
                width: stage.width;
                height: stage.height;
                visible: root.active-tab == 3;
                background: transparent;

                animate y {
                    duration: 300ms;
                    easing: spring(0.14);
                }

                Glass {
                    width: 100%;
                    height: 100%;
                    radius: 28px;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            height: 40px;
                            spacing: 10px;

                            Text {
                                text: "Консоль";
                                font-size: 20px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                animate color { duration: 200ms; }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            VerticalLayout {
                                alignment: center;
                                LiquidSegmented3 {
                                    label0: "Все";
                                    label1: "Предупр.";
                                    label2: "Ошибки";
                                    selected <=> root.log-filter;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                GlassButton {
                                    btn-height: 38px;
                                    icon: "\u{e872}";
                                    text: "Очистить";
                                    clicked => { root.clear-log(); }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 20px;
                            background: Theme.console-bg;
                            clip: true;
                            animate background { duration: 200ms; }

                            if root.log-lines.length == 0: VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                    text: "\u{e86f}";
                                    font-size: 38px;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    text: "Логи игры появятся здесь после запуска";
                                    font-size: 13px;
                                    color: Theme.text-muted;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.log-lines.length > 0: log-sv := ScrollView {
                                content-width: log-sv.visible-width;
                                VerticalLayout {
                                    width: log-sv.visible-width;
                                    padding: 16px;
                                    alignment: start;

                                    for entry in root.log-lines: VerticalLayout {
                                        if entry.level >= root.log-filter: VerticalLayout {
                                            padding-bottom: 3px;
                                            Text {
                                                text: entry.text;
                                                font-family: "Consolas";
                                                font-size: 12px;
                                                color: Theme.dark
                                                    ? (entry.level == 2 ? #FF7A73 : (entry.level == 1 ? #FFD166 : #E6EAF2))
                                                    : entry.color;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =====================================================================
    // Smooth Spring Account Sheet
    // =====================================================================
    account-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: root.show-account-dialog ? Theme.overlay-scrim-on : Theme.overlay-scrim-off;
        visible: root.show-account-dialog || account-card.y < root.height - 2px;

        animate background {
            duration: 220ms;
            easing: ease-out;
        }

        TouchArea {
            enabled: root.show-account-dialog;
            clicked => {
                root.show-account-dialog = false;
                root.play-after-nickname = false;
            }
        }

        account-card := Glass {
            width: 440px;
            height: root.recent-nicknames.length > 0 ? 372px : 300px;
            x: (parent.width - self.width) / 2;
            y: root.show-account-dialog ? (parent.height - self.height) / 2 : parent.height + 24px;
            radius: 32px;
            tint: Theme.glass-thick;

            animate y {
                duration: 340ms;
                easing: spring(0.14);
            }

            TouchArea { }

            VerticalLayout {
                padding: 26px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: Theme.accent;
                            animate background { duration: 220ms; }
                            Icon {
                                text: "\u{e7fd}";
                                font-size: 26px;
                                color: #FFFFFF;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Профиль";
                            font-size: 21px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "Любой оффлайн-ник без лицензии";
                            font-size: 12px;
                            color: Theme.text-muted;
                        }
                    }
                }

                Field {
                    field-height: 46px;
                    icon: "\u{e7fd}";
                    text <=> root.edit-nickname;
                    placeholder: "Никнейм, например Steve";
                    accepted => { root.commit-nickname(); }
                }

                if root.recent-nicknames.length > 0: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Недавние";
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-muted;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for nick in root.recent-nicknames: Rectangle {
                            height: 32px;
                            border-radius: 16px;
                            background: root.edit-nickname == nick
                                ? Theme.droplet-bg
                                : (nick-ta.has-hover ? Theme.inner-tile-hover : Theme.inner-tile);
                            border-width: root.edit-nickname == nick ? 1.5px : 0px;
                            border-color: Theme.accent;
                            animate background { duration: 150ms; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text {
                                    text: nick;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }
                            nick-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.edit-nickname = nick; }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    GlassButton {
                        horizontal-stretch: 1;
                        btn-height: 46px;
                        text: "Отмена";
                        clicked => {
                            root.show-account-dialog = false;
                            root.play-after-nickname = false;
                        }
                    }
                    GlassButton {
                        horizontal-stretch: 1;
                        btn-height: 46px;
                        kind: "primary";
                        text: root.play-after-nickname ? "Играть" : "Сохранить";
                        enabled: root.edit-nickname != "";
                        clicked => { root.commit-nickname(); }
                    }
                }
            }
        }
    }

    // =====================================================================
    // Smooth Spring First-run Unpacking Sheet
    // =====================================================================
    unpack-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: root.is-unpacking ? Theme.overlay-scrim-on : Theme.overlay-scrim-off;
        visible: root.is-unpacking || unpack-card.y < root.height - 2px;

        animate background {
            duration: 220ms;
            easing: ease-out;
        }

        TouchArea { enabled: root.is-unpacking; }

        unpack-card := Glass {
            width: 480px;
            height: root.unpack-has-error ? 300px : 220px;
            x: (parent.width - self.width) / 2;
            y: root.is-unpacking ? (parent.height - self.height) / 2 : parent.height + 24px;
            radius: 32px;
            tint: Theme.glass-thick;

            animate y {
                duration: 340ms;
                easing: spring(0.14);
            }

            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                alignment: center;

                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "Готовим Horizon 26.3";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "Первый запуск — распаковываем встроенные ассеты";
                        font-size: 12px;
                        color: Theme.text-muted;
                    }
                }

                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.fill-strong;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width * Math.clamp(root.unpack-progress, 0.0, 1.0);
                        border-radius: 4px;
                        background: @linear-gradient(90deg, Theme.accent-light 0%, Theme.accent 100%);
                        animate width { duration: 140ms; easing: ease-out; }
                    }
                }

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.unpack-status;
                        font-size: 13px;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                    Text {
                        text: root.unpack-time-left != "" ? "\{root.unpack-percent-text} · \{root.unpack-time-left}" : root.unpack-percent-text;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.accent-label;
                    }
                }

                if root.unpack-has-error: VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: root.unpack-error-text;
                        font-size: 12px;
                        color: Theme.red;
                        wrap: word-wrap;
                    }
                    GlassButton {
                        btn-height: 44px;
                        kind: "primary";
                        icon: "\u{e5d5}";
                        text: "Повторить";
                        clicked => { root.retry-unpack(); }
                    }
                }
            }
        }
    }

    // =====================================================================
    // Smooth Spring Auto-Update Sheet
    // =====================================================================
    update-overlay := Rectangle {
        width: 100%;
        height: 100%;
        background: root.show-update-dialog ? Theme.overlay-scrim-on : Theme.overlay-scrim-off;
        visible: root.show-update-dialog || update-card.y < root.height - 2px;

        animate background {
            duration: 220ms;
            easing: ease-out;
        }

        TouchArea {
            enabled: root.show-update-dialog;
            clicked => {
                if !root.update-downloading {
                    root.show-update-dialog = false;
                }
            }
        }

        update-card := Glass {
            width: 500px;
            height: root.update-error-text != "" && !root.update-downloading ? 430px : 390px;
            x: (parent.width - self.width) / 2;
            y: root.show-update-dialog ? (parent.height - self.height) / 2 : parent.height + 24px;
            radius: 28px;
            tint: Theme.glass-thick;

            animate y {
                duration: 340ms;
                easing: spring(0.14);
            }

            TouchArea { }

            VerticalLayout {
                padding: 26px;
                spacing: 14px;

                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 46px;
                            height: 46px;
                            source: Backdrop.tinted-icon;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: "Доступно обновление";
                            font-size: 20px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "v\{root.app-version} → v\{root.update-new-version}";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.accent-label;
                            }
                            if root.update-size-text != "": Text {
                                text: "· \{root.update-size-text}";
                                font-size: 13px;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 16px;
                    background: Theme.inner-tile;
                    clip: true;

                    notes-sv := ScrollView {
                        content-width: notes-sv.visible-width;
                        VerticalLayout {
                            width: notes-sv.visible-width;
                            padding: 14px;
                            alignment: start;
                            Text {
                                text: root.update-notes != "" ? root.update-notes : "Улучшения стабильности и новые функции лаунчера.";
                                font-size: 13px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.update-downloading: VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.fill-strong;
                        clip: true;
                        Rectangle {
                            x: 0px;
                            width: parent.width * Math.clamp(root.update-progress, 0.0, 1.0);
                            border-radius: 4px;
                            background: Theme.accent;
                            animate width { duration: 140ms; easing: ease-out; }
                        }
                    }

                    HorizontalLayout {
                        Text {
                            horizontal-stretch: 1;
                            text: root.update-status-text;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                        Text {
                            text: root.update-percent-text;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.accent-label;
                        }
                    }
                }

                if root.update-error-text != "" && !root.update-downloading: Text {
                    text: root.update-error-text;
                    font-size: 12px;
                    color: Theme.red;
                    wrap: word-wrap;
                }

                if !root.update-downloading: HorizontalLayout {
                    spacing: 10px;
                    GlassButton {
                        horizontal-stretch: 1;
                        btn-height: 44px;
                        text: "Потом";
                        clicked => {
                            root.show-update-dialog = false;
                            root.update-error-text = "";
                        }
                    }
                    GlassButton {
                        horizontal-stretch: 1;
                        btn-height: 44px;
                        kind: "primary";
                        icon: "\u{e2c4}";
                        text: root.update-error-text != "" ? "Повторить" : "Обновить сейчас";
                        clicked => { root.start-update(); }
                    }
                }

                if root.update-downloading: HorizontalLayout {
                    GlassButton {
                        horizontal-stretch: 1;
                        btn-height: 44px;
                        text: "Отменить загрузку";
                        clicked => { root.cancel-update(); }
                    }
                }
            }
        }
    }
}
